# Claude — für das Screenshot-Urteil (Kategorie „Eindruck", 24 % Gewicht).
# Ohne Key wird die Kategorie übersprungen.
ANTHROPIC_API_KEY=

# Nur nötig, wenn der Key keinem Workspace zugeordnet ist (Fehler 400 beim Aufruf).
# ID steht in der Console unter Settings > Workspaces, beginnt mit wrkspc_
ANTHROPIC_WORKSPACE_ID=

# Google PageSpeed Insights — optional, nur Fallback. Lighthouse läuft lokal.
PSI_API_KEY=

# Pfad zu Chrome (Standard: macOS)
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
